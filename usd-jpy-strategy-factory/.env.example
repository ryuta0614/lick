# Copy to .env and fill in locally. NEVER commit the real .env file.

# RunMode gate (§10, §36). Both of the following must be set for LIVE order
# placement to be possible anywhere in this system:
#   RUN_MODE=LIVE
#   ENABLE_LIVE_TRADING=true
# Any other combination disables order placement.
RUN_MODE=BACKTEST
ENABLE_LIVE_TRADING=false

# Kill switch (§36). When true, no new orders are placed regardless of RUN_MODE.
STOP_TRADING=false

# Rakuten MT4 account credentials -- NEVER hardcode these in source.
# Login itself is never automated by this system (§12); these are only used
# by connection-monitoring tooling to identify which account state to watch.
RAKUTEN_MT4_ACCOUNT_LABEL=demo-1

# Database
DATABASE_URL=sqlite:///data/strategy_factory.db

# Config file override
STRATEGY_FACTORY_CONFIG=config/default.yaml
