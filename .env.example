DATABASE_URL=
REDIS_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

APP_URL=
ENCRYPTION_KEY=

X_CLIENT_ID=
# Optional — only set for a "confidential" X app. A "public" app has no
# secret and relies on PKCE alone; both are supported.
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_API_BASE_URL=https://api.x.com

# Shared by both Threads and Instagram (same Meta Developer App, same Graph API).
META_APP_ID=
META_APP_SECRET=

THREADS_REDIRECT_URI=
THREADS_API_BASE_URL=https://graph.threads.net

# Instagram Content Publishing goes through Facebook Login for Business — see
# README "Instagram connection" for the Page/Instagram-Business-Account setup.
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_BASE_URL=https://graph.facebook.com
INSTAGRAM_API_VERSION=v21.0

# Safe defaults — real Threads/X/Instagram publishing each requires BOTH of
# its own two switches to be flipped explicitly (see README "Threads
# connection", "X connection", "Instagram connection" sections).
# PLATFORM_MODE is the shared fallback for THREADS_PLATFORM_MODE /
# X_PLATFORM_MODE / INSTAGRAM_PLATFORM_MODE when a platform-specific one
# isn't set.
PLATFORM_MODE=mock
THREADS_DRY_RUN=true
X_DRY_RUN=true
INSTAGRAM_DRY_RUN=true

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
